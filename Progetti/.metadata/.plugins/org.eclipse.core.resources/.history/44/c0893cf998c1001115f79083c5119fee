/* USER CODE BEGIN 0 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2) // 10Hz
    {
    	value = __HAL_TIM_GET_COUNTER(&htim3); // Leggiamo il valore del Counter

    	int16_t delta = (int16_t) (value-past_value); // Calcoliamo di quanto ci siamo spostati

    	position+=delta; // La posizione accumula gli step

    	rpm = ((float)delta/STEPS_PER_REVOLUTION)*60.0f; // Revolutions Per Minute
    	// delta viene diviso per il numero di step in una rivoluzione, moltiplicato per 60s,
    	// moltiplicato per f=1Hz in questo caso

    	past_value=value; // Aggiorniamo

    	// Se il valore è cambiato
    	if(rpm!=old_rpm){
    		// Mostriamo il nuovo valore sull'LCD
    		data_ready=1;
    		// Controlliamo se dobbiamo suonare il buzzer
    		float abs_rpm;
    		if(rpm<0){
    			abs_rpm=-rpm;
    		}else{
    			abs_rpm=rpm;
    		}
        	if(abs_rpm>5.0f && !playing){
        		playing=1;
        		HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2); // Inizia a suonare
        	}

        	if(playing && abs_rpm<5.0f){
        		playing=0;
        		HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_2); // Smetti di suonare
        	}
    	}

    	old_rpm=rpm;
    }
}

