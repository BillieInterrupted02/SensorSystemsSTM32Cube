#define LIS2DE_ADDR (0b0101000 << 1)
#define CTRL_REG1_ADDR (0x20)
#define CTRL_REG4_ADDR (0x23)
#define OUT_X_ADDR (0x29)
#define OUT_Y_ADDR (0x2B)
#define OUT_Z_ADDR (0x2D)

// 0x29 -> 0x2A -> 0x2B -> 0x2C -> 0x2D
// Sono 5 registri, uno dopo l'altro, di cui ci enteressano solo 3


#define PeriodFA4 2405   // F4 = 349.23 Hz
#define PeriodLA4 1909   // A4 = 440.00 Hz
#define PeriodSI4 1701   // B4 = 493.88 Hz
#define PeriodDO5 1605   // C5 = 523.25 Hz
#define PeriodRE5 1430   // D5 = 587.33 Hz
#define PeriodMI5 1274   // E5 = 659.25 Hz

#define SIZE_SONG 16
