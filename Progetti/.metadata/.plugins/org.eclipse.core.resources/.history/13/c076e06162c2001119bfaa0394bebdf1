/* USER CODE BEGIN 0 */
void AccelerometerInitialization(void){ // Configurazione Registri
	// CTRL1
	// ODR[3:0] = 0001
	// LPEN = 0
	// XEN, YEN, ZEN=1
	HAL_I2C_Mem_Write(&hi2c1, LIS2DE_ADDR, CTRL_REG1_ADDR, I2C_MEMADD_SIZE_8BIT, &ctrl1_config, 1, HAL_MAX_DELAY);
	// CTRL4
	// FSR = +/-2g
	HAL_I2C_Mem_Write(&hi2c1, LIS2DE_ADDR, CTRL_REG4_ADDR, I2C_MEMADD_SIZE_8BIT, &ctrl4_config, 1, HAL_MAX_DELAY);
	return;
}

void play_note(uint32_t Period, uint32_t Duration){
    duration_note=Duration;
    ticks=0;

	// Aggiorna il Periodo (frequenza) nel registro del Timer
    // L'unica variabile da ri-inizializzare è quella di base (più veloce di HAL_TIM_Base_Init)
    // Usiamo una macro veloce che accede direttamente al registro
    __HAL_TIM_SET_AUTORELOAD(&htim1, Period - 1);

    // Aggiorna il Pulse (Duty Cycle)
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, Period / 2);



    // Fai suonare nota
	HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM3)
    {
    	// Read the accelerometer
    	HAL_I2C_Mem_Read_DMA(&hi2c1, LIS2DE_ADDR, OUT_X_ADDR | 0x80, I2C_MEMADD_SIZE_8BIT, raw, 5);
    	// 0x80 = 0b 1000 0000
    	// Mettiamo il MSB = 1 per fare l'autoincrement dal registro OUT_X in poi, di 5 address
    }

	if(htim->Instance == TIM2){
		if(suona){
			ticks+=1;
			if(ticks==duration_note){
				i+=1;
				if(i==SIZE_SONG){ // Fine Canzone
					i=0;
				}
				play_note(Swan_Lake[i].Period, Swan_Lake[i].Duration);
			}
		}
	}
}

void HAL_I2C_MemRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c->Instance == I2C1)
    {
        acc[0] = ((int8_t)raw[0] * 15.6) / 1000.0;  // OUT_X
        acc[1] = ((int8_t)raw[2] * 15.6) / 1000.0;  // OUT_Y
        acc[2] = ((int8_t)raw[4] * 15.6) / 1000.0;  // OUT_Z

        //n = sprintf(message, "X: %+.2f g\r\nY: %+.2f g\r\nZ: %+.2f g\r\n", acc[0], acc[1], acc[2]);
        //HAL_UART_Transmit_DMA(&huart2, (uint8_t*)message, n);

        if(acc[2]>0.0f){
        	suona=0;
        }else{
        	suona=1;
        }
    }
}
