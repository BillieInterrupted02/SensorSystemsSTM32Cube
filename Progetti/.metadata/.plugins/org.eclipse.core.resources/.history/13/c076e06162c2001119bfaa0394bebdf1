DMA_HandleTypeDef hdma_usart2_tx;

/* USER CODE BEGIN PV */
uint8_t ctrl1_config=0x17; // 0001 0111
// ODR[3:0] = 0001 -> 1 Hz
// lPen = 0 -> Normal Mode (non low-power)
// Zen, Yen, Xen = 1 -> tutti gli assi abilitati
uint8_t ctrl4_config = 0x00; // default 0000 0000
// FSR = +/-2g e Normal Mode (non Self Test)

uint8_t raw[5]; // 5 byte
// 0x29 -> 0x2A -> 0x2B -> 0x2C -> 0x2D
// OUT_X-> 0x2A -> OUT_Y-> 0x2C -> OUT_Z
// Poi utilizzeremo solo raw[0], raw[2] e raw[4]


char message[100];
int n;

float acc[3];

// Song
int i=0;
int ticks=0;
uint32_t duration_note=500; // valore a caso

Note Swan_Lake[] = {
		{PeriodMI5, 4},
		{PeriodLA4, 1},
		{PeriodSI4, 1},
		{PeriodDO5, 1},
		{PeriodRE5, 1},
		{PeriodMI5, 3},
		{PeriodDO5, 1},
		{PeriodMI5, 3},
		{PeriodDO5, 1},
		{PeriodMI5, 3},
		{PeriodLA4, 1},
		{PeriodDO5, 1},
		{PeriodLA4, 1},
		{PeriodFA4, 1},
		{PeriodDO5, 1},
		{PeriodLA4, 4}
};

volatile uint8_t suona=0;
