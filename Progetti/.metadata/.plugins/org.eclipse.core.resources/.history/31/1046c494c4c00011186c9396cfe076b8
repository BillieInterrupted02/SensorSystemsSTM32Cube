// Potenziometro
uint32_t adc_value=0;
volatile float v_pot=0.0f;
volatile uint32_t old=0;
char lcd_buffer[16];
int bar_value=0;

volatile uint8_t changed=0;

// LED Matrix
// Definizione Lettere
static const uint8_t MATRIX_COL[NUM_LETTERS][NUM_COLS] = {{ 16,  8,  4,  2,  1 },{ 16,  8,  4,  2,  1 }};
static const uint8_t MATRIX_ROW[NUM_LETTERS][NUM_COLS] = {{ 63,127 ,127  ,127 ,127   },{0 ,0 ,0 ,0 , 0 }}; // Acceso, Spento

// Contatori
static int col_cnt = 0; // Colonna a cui siamo arrivati = 0:NUM_COLS-1
static int letter_idx=0; //  Lettera (0="O", 1="K") = 0:NUM_LETTERS-1

static int blink=0;

BlinkState_t Blink_State=NO_BLINK;


/* USER CODE END PV */

