/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_SPI1_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start(&htim2); // Timer 2 (Trigger ADC)
  HAL_ADC_Start_IT(&hadc1);   // ADC (Interrupt Mode)
  lcd_initialize();           // LCD
  lcd_backlight_ON();

  HAL_TIM_Base_Start_IT(&htim3);
  HAL_TIM_Base_Start_IT(&htim4);



  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  if(changed){
		  changed=0;

		  sprintf(lcd_buffer, "Value: %.2f V", v_pot);

		  bar_value = (int)((v_pot / 3.3f) * 80.0f);   // 0-80

		  lcd_clear();
		  lcd_println(lcd_buffer, 0);   // testo sulla riga superiore
		  lcd_drawBar(bar_value);   // barra sulla riga inferiore



	  }
  }
  /* USER CODE END 3 */
}

