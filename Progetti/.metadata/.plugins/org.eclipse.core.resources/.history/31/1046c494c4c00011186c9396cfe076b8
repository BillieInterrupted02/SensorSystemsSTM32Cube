static inline void spi_send(uint8_t col, uint8_t row){
	static uint8_t buffer[2]; // 2 byte
	// DAISY RING
	buffer[0]=row; // prima la riga
	buffer[1]=col; // poi la colonna

	// Ogni 4 ms trasmettiamo (refreshamo)
	HAL_SPI_Transmit_DMA(&hspi1, buffer, 2);
}

void HAL_SPI_TxCpltCallback(SPI_HandleTypeDef *hspi){
	if(hspi->Instance==SPI1){
		// Una volta terminata la comunicazione dei 2 byte
		// diamo un impulso su RCLK per far scattare il latch
		// dei due shift register
		HAL_GPIO_WritePin(PORT, PIN, GPIO_PIN_SET);
		HAL_GPIO_WritePin(PORT, PIN, GPIO_PIN_RESET);
	}
}



void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
{
    adc_value = HAL_ADC_GetValue(hadc);
    v_pot = ((float)adc_value * 3.3f) / 4095.0f;

    if(adc_value > old + 4 || adc_value + 4 < old){ // Soglia anti-rumore solo sui 3 LSB (4 = 100)
    	changed=1;
    	old=adc_value;
    }

    if((Blink_State==NO_BLINK) && changed){
        if(v_pot<0.5f || v_pot >2.8f){
        	letter_idx=0; // Acceso per 0.5s
        	if(v_pot<0.5f){
        	    	Blink_State = ONE_BLINK;
    		}else if(v_pot>2.8f){
        	    	Blink_State = TWO_BLINK;
    			}
        }
    }

}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
	// CALLBACK CAMBIO COLONNA (4ms)
    if (htim->Instance == TIM3){
        // refresh colonna (come hai già scritto)
        spi_send(MATRIX_COL[letter_idx][col_cnt], MATRIX_ROW[letter_idx][col_cnt]);
        col_cnt++;
        if (col_cnt == NUM_COLS){
            col_cnt = 0;
        }
    }
    // CALLBACK STATO
    else if (htim->Instance == TIM4){
    	switch (Blink_State){
    		case NO_BLINK:
    			letter_idx=1; // Spento
    			break;
    		case ONE_BLINK:
    			Blink_State=NO_BLINK;
    			letter_idx=0; // Acceso per 0.5s
    			break;
    		case TWO_BLINK:
    			blink++;
    			if(blink==1){
    				letter_idx=1; // Spento per 0.5s
    			}else if (blink==2){
    				letter_idx=0; // Acceso per 0.5s per la seconda volta
    			}else if(blink==3){
    				letter_idx=1; // Spento per 0.5s
    				blink=0;
    				Blink_State=NO_BLINK;
    			}
    			break;
    	}

    }
}

