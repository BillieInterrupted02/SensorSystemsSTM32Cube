/* USER CODE BEGIN 0 */
void AccelerometerInitialization(void){ // Configurazione Registri
	// CTRL1
	// ODR[3:0] = 0001
	// LPEN = 0
	// XEN, YEN, ZEN=1
	HAL_I2C_Mem_Write(&hi2c1, LIS2DE_ADDR, CTRL_REG1_ADDR, I2C_MEMADD_SIZE_8BIT, &ctrl1_config, 1, HAL_MAX_DELAY);
	// CTRL4
	// FSR = +/-2g
	HAL_I2C_Mem_Write(&hi2c1, LIS2DE_ADDR, CTRL_REG4_ADDR, I2C_MEMADD_SIZE_8BIT, &ctrl4_config, 1, HAL_MAX_DELAY);
	return;
}


void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2) // 1s
    {
    	// Read the accelerometer
    	HAL_I2C_Mem_Read_DMA(&hi2c1, LIS2DE_ADDR, OUT_X_ADDR | 0x80, I2C_MEMADD_SIZE_8BIT, raw, 5);
    	// 0x80 = 0b 1000 0000
    	// Mettiamo il MSB = 1 per fare l'autoincrement dal registro OUT_X in poi, di 5 address
    }

	// CALLBACK CAMBIO COLONNA (4ms)
    if (htim->Instance == TIM3){
        // refresh colonna
        spi_send(LETTER_COL[letter_idx][col_cnt], LETTER_ROW[letter_idx][col_cnt]);
        col_cnt++;
        if (col_cnt == NUM_COLS){
            col_cnt = 0;
        }
    }

}

void HAL_I2C_MemRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c->Instance == I2C1)
    {
        acc[0] = ((int8_t)raw[0] * 15.6) / 1000.0;  // OUT_X
        acc[1] = ((int8_t)raw[2] * 15.6) / 1000.0;  // OUT_Y
        acc[2] = ((int8_t)raw[4] * 15.6) / 1000.0;  // OUT_Z

        //n = sprintf(message, "X: %+.2f g\r\nY: %+.2f g\r\nZ: %+.2f g\r\n", acc[0], acc[1], acc[2]);
        //HAL_UART_Transmit_DMA(&huart2, (uint8_t*)message, n);

        if(acc[2]-acc_z_old>0.1f || acc_z_old-acc[2]>0.5f){
        	changed=1;
        }


        if(acc[2]>0.0f && old_sign==0){
        	letter_idx=1; //+
        	old_sign=1;

        }else if(acc[2]<0.0f && old_sign==1){
        	letter_idx=0; //-
        	old_sign=0;

        }
    }
}

static inline void spi_send(uint8_t col, uint8_t row){
	static uint8_t buffer[2]; // 2 byte
	// DAISY RING
	buffer[0]=row; // prima la riga
	buffer[1]=col; // poi la colonna

	// Ogni 4 ms trasmettiamo (refreshamo)
	HAL_SPI_Transmit_DMA(&hspi1, buffer, 2);
}

void HAL_SPI_TxCpltCallback(SPI_HandleTypeDef *hspi){
	if(hspi->Instance==SPI1){
		// Una volta terminata la comunicazione dei 2 byte
		// diamo un impulso su RCLK per far scattare il latch
		// dei due shift register
		HAL_GPIO_WritePin(PORT, PIN, GPIO_PIN_SET);
		HAL_GPIO_WritePin(PORT, PIN, GPIO_PIN_RESET);
	}
}






