/* USER CODE BEGIN PV */
uint8_t ctrl1_config=0x17; // 0001 0111
// ODR[3:0] = 0001 -> 1 Hz
// lPen = 0 -> Normal Mode (non low-power)
// Zen, Yen, Xen = 1 -> tutti gli assi abilitati
uint8_t ctrl4_config = 0x00; // default 0000 0000
// FSR = +/-2g e Normal Mode (non Self Test)

uint8_t raw[5]; // 5 byte
// 0x29 -> 0x2A -> 0x2B -> 0x2C -> 0x2D
// OUT_X-> 0x2A -> OUT_Y-> 0x2C -> OUT_Z
// Poi utilizzeremo solo raw[0], raw[2] e raw[4]


char message[100];
int n;

float acc[3];

// Definizione Lettere
static const uint8_t LETTER_COL[NUM_LETTERS][NUM_COLS] = {{ 16,  8,  4,  2,  1 },{ 16,  8,  4,  2,  1 }};
static const uint8_t LETTER_ROW[NUM_LETTERS][NUM_COLS] = {{ 8, 8 , 8 , 8 , 8 },{8 ,8 ,62 ,8 ,8 }}; // "-", "+"

// Contatori
static int col_cnt = 0; // Colonna a cui siamo arrivati = 0:NUM_COLS-1
static int letter_idx=0; //  Lettera (0="O", 1="K") = 0:NUM_LETTERS-1


uint8_t old_sign=0; // assumiamo sia -

// LCD
char lcd_buffer_accz[16];
uint8_t changed=0;

float acc_z_old=0.0f;


