  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  MX_TIM2_Init();
  MX_SPI1_Init();
  MX_TIM3_Init();
  /* USER CODE BEGIN 2 */
  AccelerometerInitialization();
  HAL_TIM_Base_Start_IT(&htim2);
  HAL_TIM_Base_Start_IT(&htim3);

  lcd_initialize();           // LCD
  lcd_backlight_ON();


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  if(changed){
		  changed=0;
		  lcd_clear();
		  sprintf(lcd_buffer_accz, "Z: %+.2f g", acc[2]);
		  lcd_println(lcd_buffer_accz, 0);
		  if(old_sign==0){
			  lcd_println("Negativa", 1);
		  }else{
			  lcd_println("Positiva",1);
		  }
	  }

  }
  /* USER CODE END 3 */
}

